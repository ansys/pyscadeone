    "CStructField": {
      "description": "C structure field",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "integer"
        },
        "pointer": {
          "type": "boolean"
        },
        "size": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "id",
        "name",
        "type"
      ],
